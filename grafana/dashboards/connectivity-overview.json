                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Distinguish broken blackbox scraping (up=0) from a reachable probe endpoint reporting failed ping (probe_success=0).",
          "id": 6,
          "links": [],
          "title": "Exporter and probe scrape availability",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
